# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
# PrintPilot runs OFFLINE by default (MockLLMClient). An API key is only needed
# once the real LLM backend lands in M4. All core tests must pass without one.

PRINTPILOT_LLM_BACKEND=mock        # mock | openai
PRINTPILOT_LLM_MODEL=
OPENAI_API_KEY=

# Determinism
PRINTPILOT_SEED=42
