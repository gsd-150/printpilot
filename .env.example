# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
# PrintPilot runs OFFLINE by default (MockLLMClient). A key is only needed for the
# LLM-backed diagnosis configurations. The whole core test suite passes without one.
#
# Put comments on their own line. A trailing "# ..." after a value is parsed
# inconsistently across tools and has already caused one misconfiguration here.

# mock | openai
PRINTPILOT_LLM_BACKEND=mock

# Any OpenAI-compatible endpoint. Must include the /v1 suffix.
# ChatAnywhere: https://api.chatanywhere.tech/v1  (国内)
#               https://api.chatanywhere.org/v1   (国际)
# Leave empty to talk to OpenAI directly.
PRINTPILOT_LLM_BASE_URL=

# Exact model id as your provider lists it. Hold this FIXED across the whole
# ablation — varying it compares models instead of configurations.
PRINTPILOT_LLM_MODEL=

OPENAI_API_KEY=

# Embeddings may need a different host: not every chat provider serves
# /v1/embeddings (DeepSeek's official API, for one, does not). Left empty, the
# chat endpoint above serves embeddings too — the single-relay configuration.
PRINTPILOT_EMBEDDING_BASE_URL=
PRINTPILOT_EMBEDDING_API_KEY=

# Sampling is pinned to temperature 0, but no provider guarantees determinism.
PRINTPILOT_SEED=42
